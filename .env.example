# ====================================================================
# VibeCart AI - Environment Variables Configuration
# Copy this file to .env (or backend/.env and frontend/.env)
# ====================================================================

# Google Gemini API Key (Required for AI Vibe Analysis & Regret-Shield)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Defaults to gemini-3.8-flash)
# Options: gemini-3.8-flash, gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.8-flash

# SerpApi API Key (Optional: for real Google Shopping live product cards)
# If omitted or left empty, VibeCart automatically falls back to curated live deep-links
SERPAPI_KEY=your_serpapi_key_here

# Supabase PostgreSQL & Auth Credentials
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Server Configurations
PORT=8000
HOST=0.0.0.0
FRONTEND_PORT=5173
